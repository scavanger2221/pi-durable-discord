# The bot token. `npm run setup` writes it here; everything else goes in config.json.
DISCORD_TOKEN=

# Any setting in config.json can also be set here, and wins over the file. For example:
# DISCORD_ALLOWED_USERS=123456789012345678
# PI_PROVIDER=anthropic
# PI_MODEL=claude-sonnet-5-5
# PI_MCP_CONFIG=none
# LOG_LEVEL=debug
