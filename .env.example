DISCORD_TOKEN=
# Who may prompt (user ids and/or role ids, comma-separated). Everyone allowed can run shell commands on this host.
DISCORD_ALLOWED_USERS=
DISCORD_ALLOWED_ROLES=
# Optional: limit where tasks start, and register slash commands instantly in these guilds.
DISCORD_CHANNELS=
DISCORD_GUILDS=

# Model (defaults to pi's ~/.pi/agent/settings.json); credentials come from pi's auth.json or the provider's API key.
PI_PROVIDER=deepseek
PI_MODEL=deepseek-flash
PI_THINKING=medium

PI_WORKDIR=./workspace
PI_WORKSPACE_MODE=per-thread
PI_DATA_DIR=./data

# MCP servers (mcpServers format; default pi's ~/.pi/agent/mcp.json, `none` to turn off) and the codemode tool.
# PI_MCP_CONFIG=none
# PI_CODEMODE=off
