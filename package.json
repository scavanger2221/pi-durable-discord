{
  "name": "pi-durable-discord",
  "version": "0.1.0",
  "description": "Durable pi agent with Discord as the gateway: every prompt runs as its own task in its own thread",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "setup": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings src/setup.ts",
    "check": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings src/check.ts",
    "start": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings src/main.ts",
    "schema": "node --experimental-strip-types --no-warnings src/schema.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-codemode": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@earendil-works/pi-mcp": "1.4.0",
    "discord.js": "14.27.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
